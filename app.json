{
  "expo": {
    "name": "scanner",
    "slug": "scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.raeedabdal.scanner",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "react-native-document-scanner-plugin",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save scanned PDFs.",
          "isAccessMediaLocationPermissionEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "ndkVersion": "26.1.10909125"
          }
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/font/Dtpkn0ms.ttf",
            "./assets/font/Dtpkn0s.ttf",
            "./assets/font/Dtpkn0sn.ttf",
            "./assets/font/PgKnask.ttf",
            "./assets/font/Pgdnaskh.ttf",
            "./assets/font/ShBaibwnKurdish.ttf",
            "./assets/font/ShBnaushKurdish.ttf",
            "./assets/font/ShHalalaKurdish.ttf",
            "./assets/font/ShHeroKurdish.ttf",
            "./assets/font/ShKhaldarKurdish.ttf",
            "./assets/font/ShKhunchaKurdish.ttf",
            "./assets/font/ShKnerKurdish.ttf",
            "./assets/font/ShNergzKurdish.ttf",
            "./assets/font/ShReihanKurdish.ttf",
            "./assets/font/ShSamikKurdish.ttf",
            "./assets/font/ShSharifKurdish.ttf",
            "./assets/font/ShShamamKurdish.ttf",
            "./assets/font/ShShilanKurdish.ttf",
            "./assets/font/ShShlerKurdish.ttf",
            "./assets/font/ShSunbulKurdish.ttf",
            "./assets/font/ShSusanKurdish.ttf",
            "./assets/font/ShYasmeenKurdish.ttf"
          ]
        }
      ]
    ]
  }
}
